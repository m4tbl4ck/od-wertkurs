{
  "schemaVersion": "od-design-system-project/v1",
  "id": "wertkurs",
  "name": "wertkurs",
  "category": "Finance & Fintech",
  "description": "The brand system of wertkurs (Matthias Schwarz, full-service financial advisor). A deliberately human, un-bank-like fintech look: clean neo-grotesque type in UPPERCASE, a signature mint-green field, a Ming→Lotus wordmark gradient, an 80s cassette-sleeve spectrum pinstripe, and 16-bit pixel-art brand characters (Werner the flamingo, founder emoticons). Clear structure, edutainment voice, German Du-form.",
  "source": {
    "type": "bundled",
    "origin": "wertkurs Design System (brand of Matthias Schwarz / Vertriebspartner FiNUM.Finanzhaus AG). Re-authored into the Open Design package contract from the bundled wertkurs colors_and_type.css foundation."
  },
  "importMode": "normalized",
  "files": {
    "design": "DESIGN.md",
    "tokens": "tokens.css",
    "designTokens": "design-tokens.json",
    "tailwind": "tailwind-v4.css",
    "components": "components.html"
  },
  "usage": "USAGE.md",
  "componentsManifest": "components.manifest.json",
  "assetsDir": "assets",
  "system": {
    "dir": "system",
    "note": "Derived, self-contained preview bundle (OpenDesign system/ convention): each page inlines the tokens.css :root paste plus a neutral --od-* alias layer. Regenerate from tokens.css; do not hand-edit.",
    "files": [
      { "path": "system/index.html", "role": "hub", "title": "System assets hub" },
      { "path": "system/kit.html", "role": "kit", "title": "Component kit (light)" },
      { "path": "system/kit.dark.html", "role": "kit-dark", "title": "Component kit (dark)" },
      { "path": "system/tokens.default.json", "role": "theme-config", "title": "Compact ThemeConfig defaults" }
    ]
  },
  "craft": {
    "applies": ["landing-page", "deck", "social-post", "flier", "email", "document"],
    "suggested": ["landing-page", "deck", "social-post"],
    "exemptions": ["three-d", "animated-video"]
  },
  "preview": {
    "dir": "preview",
    "pages": [
      { "path": "preview/colors.html", "role": "colors", "title": "Color roles & spectrum" },
      { "path": "preview/typography.html", "role": "typography", "title": "Type scale & casing" },
      { "path": "preview/spacing.html", "role": "spacing", "title": "Spacing, radius & elevation" },
      { "path": "preview/brand.html", "role": "brand", "title": "Brand vocabulary — Werner, spectrum, retro" },
      { "path": "preview/data-viz.html", "role": "data-viz", "title": "Charts & Beratungstools (live kits)" }
    ]
  },
  "kits": {
    "dir": "kits",
    "note": "Vendored wertkurs UI-kit files that need a runtime or their own client-first CSS (not the token contract). Consumed by preview/data-viz.html and the Beratungstool preview pages.",
    "files": [
      { "path": "kits/wertkurs-charts.js", "role": "chart-engine", "globals": "WK", "requires": "chart.js@4" },
      { "path": "kits/wertkurs-charts.css", "role": "chart-styles" },
      { "path": "kits/beratungstools.css", "role": "advisory-tool-styles" },
      { "path": "kits/ruhestandsdisplay.css", "role": "advisory-tool-styles" },
      { "path": "kits/colors_and_type.css", "role": "client-first-tokens", "note": "brand --color-* / --font-* names the kits reference" }
    ]
  },
  "sourceFiles": {
    "scanned": "source/scanned-files.json",
    "evidence": "source/evidence.md",
    "tokens": "source/tokens.source.json",
    "report": "source/token-contract.report.json",
    "snippets": "source/snippets/INDEX.json"
  }
}
