{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "wertkurs — Design Tokens JSON derived from tokens.css. Regenerate from tokens.css + source/token-contract.report.json; do not hand-edit.",
  "color": {
    "bg":           { "$type": "color", "$value": "#ffffff", "$description": "A1-identity — page canvas" },
    "surface":      { "$type": "color", "$value": "#ffffff", "$description": "A1-identity — card / lifted container" },
    "surface-warm": { "$type": "color", "$value": "#f2f2f2", "$description": "B-slot — tertiary surface tier" },
    "fg":    { "$type": "color", "$value": "#1b1b1b", "$description": "A1-identity — primary text" },
    "fg-2":  { "$type": "color", "$value": "#4d4d4d", "$description": "B-slot — secondary text" },
    "muted": { "$type": "color", "$value": "#808080", "$description": "A1-identity — subtext / captions" },
    "meta":  { "$type": "color", "$value": "#b3b3b3", "$description": "B-slot — tertiary / metadata" },
    "border":      { "$type": "color", "$value": "#d9d9d9", "$description": "A1-identity — default border" },
    "border-soft": { "$type": "color", "$value": "rgba(2,2,2,0.08)", "$description": "B-slot — inner hairline" },
    "accent":        { "$type": "color", "$value": "#d962b7", "$description": "A1-identity — Ming interactive accent" },
    "accent-on":     { "$type": "color", "$value": "#ffffff", "$description": "A2 — fg on accent fills" },
    "accent-hover":  { "$type": "color", "$value": "color-mix(in oklab, #d962b7, black 8%)", "$description": "A2" },
    "accent-active": { "$type": "color", "$value": "color-mix(in oklab, #d962b7, black 14%)", "$description": "A2" },
    "success": { "$type": "color", "$value": "#2e9e6b", "$description": "A2 — growth green" },
    "warn":    { "$type": "color", "$value": "#d99a06", "$description": "A2 — amber" },
    "danger":  { "$type": "color", "$value": "#f25835", "$description": "A2 — Lotus coral" },
    "wk-mint":   { "$type": "color", "$value": "#8fd9b6", "$description": "C-extension — signature mint field" },
    "wk-makara": { "$type": "color", "$value": "#f2e96d", "$description": "C-extension — sun yellow" },
    "wk-lotus":  { "$type": "color", "$value": "#f25835", "$description": "C-extension — coral" },
    "wk-ming":   { "$type": "color", "$value": "#d962b7", "$description": "C-extension — magenta" },
    "wk-purple": { "$type": "color", "$value": "#9d62d9", "$description": "C-extension — violet" },
    "wk-forest": { "$type": "color", "$value": "#1d402f", "$description": "C-extension — trust-badge green" }
  },
  "gradient": {
    "brand":    { "$type": "gradient", "$value": "linear-gradient(90deg,#d962b7 0%,#dd60a1 20%,#e75c6a 63%,#f25835 100%)", "$description": "C-extension — Ming→Lotus wordmark gradient" },
    "spectrum": { "$type": "gradient", "$value": "linear-gradient(90deg,#9d62d9,#d962b7,#f25835,#f2e96d,#8fd9b6)", "$description": "C-extension — five-colour brand spectrum" }
  },
  "fontFamily": {
    "display": { "$type": "fontFamily", "$value": ["new-hero","Inter","Helvetica Neue","Arial","sans-serif"], "$description": "A1-identity — all headings" },
    "body":    { "$type": "fontFamily", "$value": ["new-hero","Inter","Helvetica Neue","Arial","sans-serif"], "$description": "A1-identity — body" },
    "mono":    { "$type": "fontFamily", "$value": ["IBM Plex Mono","ui-monospace","SF Mono","Menlo","monospace"], "$description": "A2" },
    "logo":    { "$type": "fontFamily", "$value": ["new-astro","Orbitron","sans-serif"], "$description": "C-extension — wordmark only" }
  },
  "fontSize": {
    "xs":   { "$type": "dimension", "$value": "0.75rem" },
    "sm":   { "$type": "dimension", "$value": "0.875rem" },
    "base": { "$type": "dimension", "$value": "1rem" },
    "lg":   { "$type": "dimension", "$value": "1.25rem" },
    "xl":   { "$type": "dimension", "$value": "clamp(1.4rem, 2vw, 1.9rem)" },
    "2xl":  { "$type": "dimension", "$value": "clamp(1.9rem, 3vw, 2.75rem)" },
    "3xl":  { "$type": "dimension", "$value": "clamp(2.4rem, 4.5vw, 4rem)" },
    "4xl":  { "$type": "dimension", "$value": "clamp(3rem, 6vw, 5.5rem)" }
  },
  "lineHeight": {
    "body":  { "$type": "number", "$value": 1.6 },
    "tight": { "$type": "number", "$value": 1.04 }
  },
  "letterSpacing": {
    "display": { "$type": "dimension", "$value": "-0.01em" }
  },
  "space": {
    "1":  { "$type": "dimension", "$value": "4px" },
    "2":  { "$type": "dimension", "$value": "8px" },
    "3":  { "$type": "dimension", "$value": "12px" },
    "4":  { "$type": "dimension", "$value": "16px" },
    "5":  { "$type": "dimension", "$value": "20px" },
    "6":  { "$type": "dimension", "$value": "24px" },
    "8":  { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" }
  },
  "sectionRhythm": {
    "desktop": { "$type": "dimension", "$value": "128px" },
    "tablet":  { "$type": "dimension", "$value": "96px" },
    "phone":   { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "8px", "$description": "standard — cards, inputs, buttons, tags" },
    "md":   { "$type": "dimension", "$value": "12px" },
    "lg":   { "$type": "dimension", "$value": "16px" },
    "pill": { "$type": "dimension", "$value": "999px", "$description": "avatars only — never buttons" }
  },
  "shadow": {
    "flat":   { "$type": "shadow", "$value": "none" },
    "ring":   { "$type": "shadow", "$value": "0 0 0 1px #d9d9d9" },
    "raised": { "$type": "shadow", "$value": "0 4px 16px rgba(2,2,2,0.08), 0 1px 4px rgba(2,2,2,0.05)" },
    "sticker":{ "$type": "shadow", "$value": "4px 4px 0 #1b1b1b", "$description": "C-extension — hard offset, no blur" },
    "brand-mint": { "$type": "shadow", "$value": "0 16px 40px rgba(143,217,182,0.45)", "$description": "C-extension" },
    "brand-ming": { "$type": "shadow", "$value": "0 12px 30px rgba(217,98,183,0.30)", "$description": "C-extension" },
    "focus-ring": { "$type": "shadow", "$value": "0 0 0 3px color-mix(in oklab, #d962b7, transparent 65%)" }
  },
  "motion": {
    "fast":         { "$type": "duration", "$value": "150ms" },
    "base":         { "$type": "duration", "$value": "200ms" },
    "ease-standard":{ "$type": "cubicBezier", "$value": [0.23, 1, 0.32, 1] },
    "ease-bounce":  { "$type": "cubicBezier", "$value": [0.34, 1.56, 0.64, 1], "$description": "C-extension — mascot moments" }
  },
  "layout": {
    "container-max":            { "$type": "dimension", "$value": "1200px" },
    "container-gutter-desktop": { "$type": "dimension", "$value": "32px" },
    "container-gutter-tablet":  { "$type": "dimension", "$value": "24px" },
    "container-gutter-phone":   { "$type": "dimension", "$value": "16px" }
  }
}
